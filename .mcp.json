{
  "mcpServers": {
    "trigger": {
      "args": [
        "trigger.dev@4.4.0",
        "mcp"
      ],
      "command": "npx"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "dataforseo": {
      "command": "npx",
      "args": [
        "dataforseo-mcp-server@3.1.3"
      ],
      "env": {
        "DATAFORSEO_LOGIN": "${DATAFORSEO_LOGIN}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    }
  }
}
