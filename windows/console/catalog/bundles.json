  "variants": [
    {
      "id": "proactive-business-gcch",
      "label": "ProActive Business (GCC High)",
      "badge": "Operations",
      "extends": "proactive-business",
      "managed": true,
      "profile": {"gcch": true},
      "notes": "GCCH does not automatically carry the commercial MDR package: every security agent waits on gate.gcch-verified until a technician records that the provider is authorised for the boundary."
    },
    {
      "id": "proactive-enterprise-gcch",
      "label": "ProActive Enterprise (GCC High)",
      "badge": "Compliance",
      "extends": "proactive-enterprise",
      "managed": true,
      "profile": {"gcch": true},
      "notes": "As Business (GCC High)."
    },
    {
      "id": "co-managed",
      "label": "Co-Managed IT",
      "badge": "Co-managed",
      "managed": true,
      "components": {"note": "Separate path, not a tier: the client's IT keeps parts of the stack; DE runs only the areas in coManaged.deOwns."},
      "profile": {"tier": "Co-managed"},
      "plan": {"exclude": ["^branding\\."], "coManagedAreas": true}
    }
  ],
  "addOns": [
    {
      "id": "endpoint-backup",
      "label": "Endpoint backup",
      "profile": {"backup": {"required": true}},
      "plan": {"reinclude": ["^ops\\.backup$"]}
    },
    {
      "id": "managed-network",
      "label": "Managed Physical Site Network",
      "plan": {"reinclude": ["^net\\.site$"]}
    },
    {
      "id": "sase",
      "label": "Cloud Edge / SASE",
      "profile": {"network": {"sase": {"required": true}}},
      "plan": {"reinclude": ["^net\\.sase$"]}
    },
    {
      "id": "blackpoint-mdr",
      "label": "Backup MDR (approved alternate)",
      "profile": {"security": {"mdr": {"deployAdd": ["blackpoint"]}}},
      "plan": {}
    },
    {
      "id": "advanced-managed-workplace",
      "label": "Advanced Managed Workplace",
      "plan": {}
    },
    {
      "id": "ucaas",
      "label": "UCaaS",
      "plan": {},
      "manualSteps": [
        {"id": "ucaas-softphone", "title": "Softphone or desk phone provisioned and test call placed"}
      ]
    },
    {
      "id": "spend-card-controls",
      "label": "Spend-Card Controls",
      "plan": {}
    }
  ],
  "coManagedAreas": {
    "identity": ["^identity\\.", "^jumpcloud\\."],
    "security": ["^security\\."],
    "apps": ["^apps\\."],
    "baseline": ["^baseline\\."],
    "browser": ["^browser\\."],
    "updates": ["^maint\\."],
    "backup": ["^ops\\.backup$"],
    "network": ["^net\\."],
    "support": ["^ops\\.remote-support$", "^jumpcloud\\.remote-assist$"],
    "mfa": ["^ops\\.mfa$", "^ops\\.email-security$"]
  },
  "standaloneExclude": ["^branding\\.shortcuts$", "^ops\\.remote-support$", "^jumpcloud\\.remote-assist$"],
  "standaloneSolutions": {
    "it_operations": {
      "id": "it_operations",
      "label": "IT Operations & Support",
      "actionModules": ["maintenance", "operations"],
      "endpoint": true,
      "includeOnly": ["^maint\\.", "^apps\\.", "^ops\\.remote-support$", "^jumpcloud\\.(agent|remote-assist|policies)"],
      "keepSupport": true
    },
    "endpoint_devices": {
      "id": "endpoint_devices",
      "label": "Endpoint & Device Management",
      "actionModules": ["apps", "baseline", "branding"],
      "endpoint": true,
      "includeOnly": ["^jumpcloud\\.(agent|bind-user|user-mapping|group\\.|usergroup\\.|policies)", "^maint\\.", "^baseline\\.", "^apps\\.", "^security\\.edr-conflicts$", "^identity\\.bitlocker", "^branding\\.hostname$"],
      "prerequisites": [
        {"id": "device-policy", "title": "Device classification and ownership policy approved by the client"}
      ]
    },
    "identity_access": {
      "id": "identity_access",
      "label": "Identity & Access",
      "actionModules": ["identity", "jumpcloud"],
      "endpoint": true,
      "includeOnly": ["^identity\\.", "^jumpcloud\\.", "^ops\\.mfa$"],
      "manualSteps": [
        {"id": "privileged-review", "title": "Privileged-access review recorded for this user and device"}
      ]
    },
    "email_collaboration": {
      "id": "email_collaboration",
      "label": "Email & Collaboration",
      "actionModules": ["apps", "operations"],
      "endpoint": true,
      "includeOnly": ["^apps\\.(m365|teams|onedrive|dropbox)", "^ops\\.email-security$", "^ops\\.mfa$"],
      "manualSteps": [
        {"id": "tenant-baseline", "title": "Tenant email-protection baseline applied (SPF, DKIM, DMARC checked)"}
      ]
    },
    "cybersecurity_operations": {
      "id": "cybersecurity_operations",
      "label": "Cybersecurity Operations",
      "actionModules": ["security"],
      "endpoint": true,
      "includeOnly": ["^security\\.", "^baseline\\.", "^browser\\.", "^identity\\.bitlocker"],
      "prerequisites": [
        {"id": "assessment", "title": "Cyber risk assessment completed for this client"}
      ]
    },
    "network_connectivity": {
      "id": "network_connectivity",
      "label": "Network & Connectivity",
      "actionModules": ["network"],
      "endpoint": true,
      "includeOnly": ["^net\\."],
      "manualSteps": [
        {"id": "site-network", "title": "Site gateway, Wi-Fi and VLANs configured in the network console"}
      ]
    },
    "backup_continuity": {
      "id": "backup_continuity",
      "label": "Backup & Business Continuity",
      "actionModules": ["operations", "apps"],
      "endpoint": true,
      "includeOnly": ["^ops\\.backup$", "^identity\\.bitlocker", "^maint\\.bitlocker-resume$"],
      "manualSteps": [
        {"id": "restore-test", "title": "Restore test completed and recorded"}
      ]
    },
    "compliance_risk": {
      "id": "compliance_risk",
      "label": "Compliance & Risk Readiness",
      "actionModules": ["baseline", "evidence"],
      "endpoint": true,
      "includeOnly": ["^baseline\\.", "^security\\.edr-conflicts$", "^identity\\.bitlocker"],
      "manualSteps": [
        {"id": "evidence-review", "title": "Evidence bundle reviewed against the client's framework scope (readiness, not certification)"}
      ]
    },
    "security_awareness": {
      "id": "security_awareness",
      "label": "Security Awareness & Human Risk",
      "actionModules": ["operations"],
      "endpoint": false,
      "includeOnly": [],
      "manualSteps": [
        {"id": "enrolled", "title": "User enrolled in awareness training and phishing simulation"}
      ]
    },
    "business_communications": {
      "id": "business_communications",
      "label": "Business Communications",
      "actionModules": ["apps"],
      "endpoint": false,
      "includeOnly": [],
      "manualSteps": [
        {"id": "voice", "title": "Phone, softphone or Threadline service provisioned and test call placed"}
      ]
    },
    "hardware_lifecycle": {
      "id": "hardware_lifecycle",
      "label": "Hardware & Lifecycle",
      "actionModules": ["maintenance"],
      "endpoint": true,
      "includeOnly": ["^branding\\.hostname$", "^maint\\.", "^apps\\.", "^baseline\\.", "^identity\\.bitlocker", "^order\\."],
      "manualSteps": [
        {"id": "asset-recorded", "title": "Asset, warranty and assigned user recorded in documentation"}
      ]
    },
    "documentation_standards": {
      "id": "documentation_standards",
      "label": "Documentation & Standards",
      "actionModules": ["branding", "evidence"],
      "endpoint": false,
      "includeOnly": [],
      "manualSteps": [
        {"id": "documented", "title": "Device and configuration documented from the evidence bundle"}
      ]
    },
    "technology_strategy": {
      "id": "technology_strategy",
      "label": "Technology Strategy & Advisory",
      "actionModules": ["evidence"],
      "endpoint": false,
      "includeOnly": [],
      "manualSteps": [
        {"id": "roadmap", "title": "Findings added to the client roadmap"}
      ]
    }
  },
  "modes": {
    "dropship": {
      "label": "Dropship / pre-provision",
      "description": "DE prepares a known client device before direct shipment or handoff. The local engine remains usable offline; connected mode can later sync the signed result to the Hub.",
      "excludedActionIds": ["identity.migrate", "identity.verify-migration", "identity.entra-leave", "identity.mdm-cleanup", "identity.hello-reset"]
    }
  }
