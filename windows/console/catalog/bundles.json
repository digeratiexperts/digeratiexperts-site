      "capabilities": ["it_operations", "endpoint_devices", "identity_access", "email_collaboration", "cybersecurity_operations", "network_connectivity", "backup_continuity", "compliance_risk", "security_awareness", "business_communications", "hardware_lifecycle", "documentation_standards", "technology_strategy"],
      "defaults": {"identity": "jumpcloud", "edr": "sentinelone", "mdr": "guardz", "guardzPackage": "Elite", "humanMdr": true, "browserSecurity": ["pabx"], "baseline": "de-windows-baseline", "emailSecurity": "mimecast", "awareness": "ninjio", "remoteSupport": "jumpcloud-remote-assist", "backup": "msp360", "networkManaged": true, "siem": "wazuh", "sase": "timus", "vulnerability": "qualys", "privilegedAccess": true, "complianceDepth": "advanced"},
      "optional": ["blackpoint-mdr-backup"],
      "rules": ["Deepest managed-security posture plus DE governance/compliance depth. Regulated/GCC High eligibility remains verification-required."],
      "bundleId": "proactive-enterprise",
