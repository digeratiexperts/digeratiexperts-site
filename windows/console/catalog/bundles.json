      "managed": true,
      "components": {"securityFoundation": "included", "endpoint": "advanced", "emailSecurity": "advanced", "identity": "identity governance", "detection": "advanced / custom", "mdrPackage": "Guardz Elite", "awareness": "role-based", "endpointBackup": "custom", "bcdr": "custom", "cloudStorageBackup": "custom", "managedNetwork": "multi-site", "managedWorkplace": "custom", "remoteSupport": "included", "vcio": "quarterly", "complianceMinimum": "Governance", "evidence": "audit-grade"},
      "profile": {"tier": "Enterprise", "backup": {"required": true}, "security": {"mdr": {"deploy": ["guardz"], "package": "Elite"}, "siem": "wazuh"}, "network": {"sase": {"required": false}}},
