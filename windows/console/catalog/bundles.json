      "bundleId": "proactive-business",
      "badge": "Operations",
      "managed": true,
      "components": {"securityFoundation": "included", "endpoint": "enhanced EDR", "emailSecurity": "enhanced", "identity": "enhanced", "detection": "24/7 MDR + deeper response", "mdrPackage": "Guardz Ultimate", "awareness": "enhanced", "endpointBackup": "yes", "bcdr": "yes", "cloudStorageBackup": "yes", "managedNetwork": "yes", "managedWorkplace": "enhanced", "remoteSupport": "included", "vcio": "2x per year", "complianceMinimum": "Regulated"},
      "profile": {"tier": "Business", "backup": {"required": true}, "security": {"mdr": {"deploy": ["guardz"], "package": "Ultimate"}, "siem": "wazuh"}, "network": {"sase": {"required": false}}},
      "plan": {"exclude": ["^net\\.sase$"]},
      "addOns": ["sase", "blackpoint-mdr"]
