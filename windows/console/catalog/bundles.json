      "components": {"securityFoundation": "included", "endpoint": "stronger", "emailSecurity": "advanced anti-phishing", "identity": "stronger", "detection": "24/7 MDR", "mdrPackage": "Guardz Ultimate", "awareness": "included + phishing simulation", "endpointBackup": "yes", "bcdr": "add-on", "managedNetwork": "yes", "managedWorkplace": "limited", "remoteSupport": "included", "vcio": "1x per year"},
      "profile": {"tier": "Office", "backup": {"required": true}, "security": {"mdr": {"deploy": ["guardz"], "package": "Ultimate"}}, "network": {"sase": {"required": false}}},
      "plan": {"exclude": ["^net\\.sase$"]},
      "addOns": ["sase", "blackpoint-mdr", "advanced-managed-workplace"]
    },
    "Business": {
      "id": "business",
      "label": "ProActive Business",
      "capabilities": ["it_operations", "endpoint_devices", "identity_access", "email_collaboration", "cybersecurity_operations", "network_connectivity", "backup_continuity", "compliance_risk", "security_awareness", "business_communications", "hardware_lifecycle", "documentation_standards", "technology_strategy"],
      "defaults": {"identity": "jumpcloud", "edr": "sentinelone", "mdr": "guardz", "guardzPackage": "Ultimate", "humanMdr": true, "browserSecurity": ["pabx"], "baseline": "de-windows-baseline", "emailSecurity": "mimecast", "awareness": "ninjio", "remoteSupport": "jumpcloud-remote-assist", "backup": "msp360", "networkManaged": true, "siem": "wazuh", "recoveryDepth": "bcdr-posture"},
      "optional": ["sase", "vulnerability-scanning", "blackpoint-mdr-backup"],
