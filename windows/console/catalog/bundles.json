      "defaults": {"identity": "jumpcloud", "edr": "sentinelone", "mdr": "guardz", "guardzPackage": "Ultimate", "humanMdr": true, "browserSecurity": ["pabx"], "baseline": "de-windows-baseline", "emailSecurity": "mimecast", "awareness": "ninjio", "remoteSupport": "jumpcloud-remote-assist", "backup": "msp360", "networkManaged": true},
      "optional": ["siem", "sase", "vulnerability-scanning"],
