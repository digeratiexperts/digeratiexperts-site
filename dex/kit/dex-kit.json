    },
    {
      "id": "waiting-on-client",
      "situation": "Dex needs one answer from the client to continue.",
      "signals": {
        "audience": "client",
        "phase": "waiting",
        "topic": "general",
        "urgency": 1
      },
      "presence": {
        "mode": "curious",
        "state": "speaking",
        "form": "bubble",
        "mustHandOff": false,
        "reason": "Waiting on the client: ask one clear question."
      }
    },
    {
      "id": "routine-ticket-closed",
      "situation": "A routine request is confirmed done.",
      "signals": {
        "audience": "client",
        "phase": "resolved",
        "topic": "general",
        "urgency": 0
      },
      "presence": {
        "mode": "done",
        "state": "speaking",
        "form": null,
        "mustHandOff": false,
        "reason": "Routine outcome confirmed: a quiet done, no celebration."
      }
    },
    {
      "id": "billing-question",
      "situation": "A client asks about an invoice or payment.",
      "signals": {
        "audience": "client",
        "phase": "handoff",
        "topic": "billing",
        "urgency": 1
      },
      "presence": {
        "mode": "reassuring",
        "state": "speaking",
        "form": "bubble",
        "mustHandOff": true,
        "reason": "Handing to a DE technician: calm, and say a person is taking over."
      }
    },
    {
      "id": "security-alert-open",
      "situation": "A security alert is open and needs a person soon.",
      "signals": {
        "audience": "client",
        "phase": "working",
        "topic": "security",
        "urgency": 2
      },
      "presence": {
        "mode": "alert",
        "state": "listening",
        "form": "ring",
        "mustHandOff": true,
        "reason": "Needs attention soon, not yet an incident."
      }
    },
    {
      "id": "security-fixed-unverified",
      "situation": "A security fix is reported but not yet verified.",
      "signals": {
        "audience": "client",
        "phase": "resolved",
        "topic": "security",
        "urgency": 1
      },
      "presence": {
        "mode": "reassuring",
        "state": "speaking",
        "form": null,
        "mustHandOff": true,
        "reason": "Resolved, but security and billing are not celebrated until a person verifies them."
      }
    },
    {
      "id": "outage-incident",
      "situation": "A live outage is affecting a client.",
      "signals": {
        "audience": "client",
        "phase": "working",
        "topic": "outage",
        "urgency": 3
      },
      "presence": {
        "mode": "extreme",
        "state": "thinking",
        "form": "ring",
        "mustHandOff": true,
        "reason": "Live security or outage at urgency 3: full alert, attention ring, a person takes it."
      }
    },
    {
      "id": "automation-failed",
      "situation": "An automated step failed.",
      "signals": {
        "audience": "client",
        "phase": "failed",
        "topic": "general",
        "urgency": 1
      },
      "presence": {
        "mode": "concerned",
        "state": "listening",
        "form": "bubble",
        "mustHandOff": true,
        "reason": "A step failed: show concern, say so, hand to a person. Never claim a fix."
      }
    },
    {
      "id": "hand-to-technician",
