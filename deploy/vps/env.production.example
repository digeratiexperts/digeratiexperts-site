# Production environment for the Digerati Experts public website.
#
# Copy to /home/<site>/shared/.env on the VPS and fill in real values there.
# NEVER commit real values to this repository. Set restrictive permissions:
#   chown <site-user>:<site-user> /home/<site>/shared/.env
#   chmod 600 /home/<site>/shared/.env

NODE_ENV=production
# staging: 3200 · production: 3300 (3100 is taken by the Intelligence Hub)
PORT=3300

# --- Database -------------------------------------------------------------
# Initial migration: keep pointing at the existing production Postgres used
# by the Replit deployment (Neon/Replit DB) so no data migration is needed
# on cutover. Moving the DB onto the VPS is a separate, later decision.
DATABASE_URL=

# --- Security (generate fresh values, 32+ chars) ---------------------------
JWT_SECRET=
SESSION_SECRET=
# Dedicated AES-GCM key for portal TOTP secrets. Generate independently from
# JWT/session keys and retain it across releases; rotating it requires a data migration.
MFA_ENCRYPTION_KEY=
# Cloudflare Turnstile server secret (portal sign-in bot protection), from the
# same Cloudflare widget as VITE_TURNSTILE_SITE_KEY below. Rollout order: first
# deploy a release built WITH the site key and confirm the challenge shows on
# /portal/login; only then set this and restart. A secret without the site key
# in the bundle rejects every portal sign-in. TURNSTILE_ENFORCE=1 fails closed
# when the secret is missing.
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCE=1

# --- Domain ----------------------------------------------------------------
MAIN_DOMAIN=digeratiexperts.com
PORTAL_DOMAIN=portal.digeratiexperts.com
ALLOWED_ORIGINS=https://digeratiexperts.com,https://portal.digeratiexperts.com

# --- Integrations (use the ROTATED credentials, not the leaked ones) -------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Quiz leads get a scheduled call in Zoho CRM (issue 449). Optional: the id of
# a Leads assignment rule, so the rule picks who calls; unset = the API user.
# ZOHO_LEAD_ASSIGNMENT_RULE_ID=
# Optional: base of Zoho lead links in the new-lead email and the Hub item.
# ZOHO_CRM_WEB_BASE=https://crm.zoho.com/crm/org667030734

# --- Zoho Connect: one-click reconnect for CRM, Desk, Books, Payments -------
# Preferred over the Self Client tokens below, which are LEGACY (they keep
# working as fallbacks). One Zoho API Console "Server-based Application", one
# consent for every product's scopes, one refresh token stored encrypted in the
# database (zoho_oauth_tokens, migration 0017); reconnecting revokes the grant
# it replaces. Inventory and runbook: docs/ZOHO-OAUTH-INVENTORY.md.
# Register this redirect URI on that client (DE does this in Zoho; the code
# never registers anything):
#   https://digeratiexperts.com/api/zoho/connect/callback
# Then, signed in as the owner (admin@digeratiexperts.com), open
#   https://digeratiexperts.com/api/zoho/connect
# Off unless ZOHO_CONNECT_ENABLED=true. Turning it off again makes every
# product fall back to the legacy tokens below at once.
# ZOHO_CONNECT_ENABLED=false
# ZOHO_CONNECT_CLIENT_ID=
# ZOHO_CONNECT_CLIENT_SECRET=
# Optional: only when the registered URI differs from the one above.
# ZOHO_CONNECT_REDIRECT_URI=
# Optional: Zoho data center for legacy tokens and API hosts (default US,
# https://accounts.zoho.com). A Connect grant carries its own data center.
# ZOHO_ACCOUNTS_SERVER=https://accounts.zoho.com
# Optional: key for Zoho tokens stored in the database (AES-256-GCM). Falls
# back to MFA_ENCRYPTION_KEY. Changing it only drops cached access tokens and
# the Connect grant (reconnect once); legacy env tokens are unaffected.
# ZOHO_TOKEN_ENCRYPTION_KEY=

# --- Zoho Desk and CRM for the website (server/zoho/zohoClient.ts) ----------
# LEGACY Self Client tokens: still honoured, after the Zoho Connect grant.
# The website's Desk tickets ("Get Support") and CRM leads read these names,
# not the three above. CRM always uses ZOHO_CLIENT_ID_API /
# ZOHO_CLIENT_SECRET_API with ZOHO_REFRESH_TOKEN.
#
# The Desk refresh token needs at least these scopes:
#   Desk.tickets.READ, Desk.tickets.CREATE, Desk.tickets.UPDATE,
#   Desk.contacts.READ, Desk.contacts.WRITE, Desk.settings.READ
# (the list in server/integrations/zohoAgentsReadiness.ts). A refresh token
# only works with the OAuth client that issued it, so pick one:
#   - Desk's own client (e.g. a Self Client made for the Desk): set
#     ZOHO_DESK_CLIENT_ID, ZOHO_DESK_CLIENT_SECRET and ZOHO_DESK_REFRESH_TOKEN,
#     all three from that client. If either client value is set, all three
#     are required and nothing is borrowed from CRM; with one missing the Desk
#     API stays off (tickets go through the fallback below) and the service
#     log names the missing variable.
#   - The shared client: leave ZOHO_DESK_CLIENT_ID / ZOHO_DESK_CLIENT_SECRET
#     unset and generate ZOHO_DESK_REFRESH_TOKEN from the ZOHO_CLIENT_ID_API
#     client. Without ZOHO_DESK_REFRESH_TOKEN the Desk then falls back to
#     ZOHO_FORM_OAUTH, then to ZOHO_REFRESH_TOKEN.
# Check after any change: GET /api/zoho/desk/status should read
# {"connected":true,"state":"connected"}. "state":"needs_reconnect" (reason
# "auth_failed") means Zoho refused the token (or the token came from a
# different client); "degraded" means Zoho throttled the server or was
# unreachable (it retries on its own; do not make a new token);
# "not_configured" means a value is missing.
ZOHO_CLIENT_ID_API=
ZOHO_CLIENT_SECRET_API=
ZOHO_DESK_REFRESH_TOKEN=
# ZOHO_DESK_CLIENT_ID=
# ZOHO_DESK_CLIENT_SECRET=
# When the Desk API refuses a ticket (bad token, outage), the website emails it
# to this Desk address instead and replays it by API later
# (server/deskTicketFallback.ts). Default support@thatsmytech.zohosupport.com,
# Desk's own incoming address (mail to it always becomes a ticket).
# DESK_FALLBACK_EMAIL=

# --- Portal Zoho Public Platform SSO (Client Portal login) ---------------
# Callback must be registered on the Zoho OAuth client. Prefer the canonical
# /api/portal/auth/zoho/callback; VPS may still use /api/zoho/oauth/callback.
# ZOHO_PORTAL_OIDC_REDIRECT_URI=https://portal.digeratiexperts.com/api/portal/auth/zoho/callback
# ZOHO_OAUTH_PORTAL_REDIRECT_URI=https://portal.digeratiexperts.com/api/zoho/oauth/callback
# ZOHO_OAUTH_STATE_SECRET=
# ZOHO_OIDC_ISSUER=https://accounts.zoho.com
# PORTAL_OAUTH_EMAIL_ALLOWLIST=admin@digeratiexperts.com,admin@digerati-experts.com,@digeratiexperts.com,@digerati-experts.com

# --- Zoho Payments (Store + portal invoice pay) ---------------------------
# Zoho Payments uses OAuth plus the Payments account ID. With Zoho Connect the
# refresh token and client below are not needed (account ID and signing key
# still are). LEGACY: a Self Client refresh token with
# ZohoPay.payments.CREATE,ZohoPay.payments.READ.
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_REFRESH_TOKEN=
# Optional dedicated OAuth client for Payments. When omitted, the service falls
# back to the general Zoho client ID/secret above, provided that client owns the
# Payments refresh token.
# ZOHO_PAYMENTS_CLIENT_ID=
# ZOHO_PAYMENTS_CLIENT_SECRET=
# Signing key shown when the webhook is created in Zoho Payments.
ZOHO_PAYMENTS_SIGNING_KEY=
# Webhook URL: https://digeratiexperts.com/api/webhooks/zoho-payments

# --- Zoho Books (staff Pay Now sales tax + paid-order invoices) -----------
# Books Sales Tax Automation works out the tax; Zoho Payments still charges.
# The server drafts an estimate on the tax-check contact, reads the tax and
# deletes it (server/services/zohoBooksTax.ts), and records each paid Zoho
# Payments order as a Books invoice and payment (zohoBooksInvoice.ts).
# With Zoho Connect the refresh token and client below are not needed.
# LEGACY: a Self Client refresh token with exactly these scopes:
# ZohoBooks.estimates.CREATE,ZohoBooks.estimates.DELETE,ZohoBooks.settings.READ,
# ZohoBooks.contacts.READ,ZohoBooks.contacts.CREATE,ZohoBooks.invoices.CREATE,
# ZohoBooks.invoices.READ,ZohoBooks.customerpayments.CREATE
# Any required setting unset = Pay Now steps aside to Request Quote and no
# invoices are recorded. Never commit the token or secret.
# Org "Digerati Experts" is 693714437.
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_BOOKS_REFRESH_TOKEN=
# Optional: the self-client that issued the Books token. When omitted, the
# server uses ZOHO_CLIENT_ID_API / ZOHO_CLIENT_SECRET_API above.
# ZOHO_BOOKS_CLIENT_ID=
# ZOHO_BOOKS_CLIENT_SECRET=
# The Books contact every tax-check estimate is drafted on ("DE Website Tax
# Check", 1957016000006631001), and the Books item whose tax category covers
# DE's services ("Website IT services (Pay Now)", 1957016000006629001).
ZOHO_BOOKS_TAX_CONTACT_ID=
ZOHO_BOOKS_SERVICE_ITEM_ID=
# Optional: a Books item for a category that has none yet, e.g.
# {"digital_templates":"<Books item id>"}.
# ZOHO_BOOKS_TAX_ITEMS=
# Optional: the Books bank/cash account Zoho Payments deposits land in. Unset =
# Books' default for customer payments.
# ZOHO_BOOKS_DEPOSIT_ACCOUNT_ID=
# Optional: set to false to stop recording paid orders as Books invoices.
# ZOHO_BOOKS_RECORD_PAID_ORDERS=true

JUMPCLOUD_API_KEY=
# JUMPCLOUD_ORG_ID=
# JUMPCLOUD_API_BASE=https://console.jumpcloud.com/api
# Blackpoint Cyber CompassOne (partner API) — use BLACKPOINT_API_KEY or BLACKPOINT_API_TOKEN
BLACKPOINT_API_KEY=
# BLACKPOINT_API_TOKEN=
# BLACKPOINT_API_BASE=https://api.blackpointcyber.com/v1
# BLACKPOINT_INSTALLER_URL=
CORO_CLIENT_ID=
CORO_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
# Public Ask DE advisor model tier (default gpt-4o; set gpt-4o-mini to cut cost)
MSP_ADVISOR_MODEL=gpt-4o
ADMIN_EMAIL=info@digeratiexperts.com
# Solution (#243) and store quote (#240) requests saved outside the database also email sales.
# Optional; defaults to the sales address in shared/companyContact.ts.
# SALES_LEAD_EMAIL=
# Optional; defaults to <site>/shared/spool/solution-requests (created by deploy.sh).
# SOLUTION_SPOOL_DIR=
# Optional; defaults to <site>/shared/spool/quote-requests (created by deploy.sh).
# QUOTE_SPOOL_DIR=

# --- Transactional email (ZeptoMail — not Zoho Mail for Node sends)
ZEPTOMAIL_API_TOKEN=
APP_URL=https://digeratiexperts.com

# --- Public-by-design client values (baked into the frontend at BUILD time)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACVFaZbvIxse5DMd
VITE_CLARITY_ID=fwts8lj42i
# Meta / Bing / LinkedIn — leave blank until IDs exist; requires rebuild after set
VITE_META_PIXEL_ID=
VITE_BING_UET_TAG_ID=
VITE_LINKEDIN_PARTNER_ID=
# Search Console / Bing Webmaster HTML verification token contents
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# --- Google Business / Places reviews (homepage Client Proof) -------------
# Enable Places API, then set both. See docs/GOOGLE-REVIEWS.md.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# Optional Maps CID (decimal); cannot fetch reviews alone:
# GOOGLE_MAPS_CID=

# --- TechSales / Intelligence-Hub integration bus -------------------------
# Do not rotate the live TECHSALES_SYNC_TOKEN / WEBSITE_LEAD_WEBHOOK_SECRET
# until both sides accept HMAC and the fallback PR is scheduled.
TECHSALES_HUB_URL=https://techsales.digerati-experts.com
TECHSALES_SYNC_URL=https://techsales.digerati-experts.com/api/webhooks/website-lead
TECHSALES_SYNC_TOKEN=
WEBSITE_LEAD_WEBHOOK_SECRET=
# Scoped HMAC secrets (optional; fall back to TECHSALES_SYNC_TOKEN)
WEBSITE_TO_HUB_SECRET=
PORTAL_TO_HUB_SECRET=
HUB_TO_WEBSITE_SECRET=
HUB_TO_PORTAL_SECRET=
WEBSITE_BASE_URL=https://digeratiexperts.com
PORTAL_BASE_URL=https://portal.digeratiexperts.com

# --- Client portal data sources (VPN, phone, shipping) ---------------------
# server/portalIntegrations.ts. Leave a *_PROVIDER empty to keep the page's
# sample content (today's behaviour); "hidden" removes the page from the
# portal. *_CLIENT_MAP is JSON: {"<portal clientId>": "<vendor scope>"};
# a company not in the map sees "not linked yet" and no vendor is called.
# Details and doc links: server/integrations/{vpn,phone,shipping}/README.md.
# What is set and missing, per company: /portal/admin/data-sources (DE admins).
#
# VPN: sample | hidden | tailscale | twingate | perimeter81 | timus | manual
# timus and perimeter81 are not built (no documented API yet): they answer
# "not available". Reserved, unread until the Timus adapter exists:
# PORTAL_VPN_TIMUS_API_KEY=  PORTAL_VPN_TIMUS_BASE_URL=
PORTAL_VPN_PROVIDER=
PORTAL_VPN_CLIENT_MAP=
# tailscale (scope: a device tag such as "tag:acme"); OAuth client preferred
PORTAL_VPN_TAILSCALE_OAUTH_CLIENT_ID=
PORTAL_VPN_TAILSCALE_OAUTH_CLIENT_SECRET=
PORTAL_VPN_TAILSCALE_API_KEY=
PORTAL_VPN_TAILSCALE_TAILNET=
# twingate (scope: a Twingate group id)
PORTAL_VPN_TWINGATE_NETWORK=
PORTAL_VPN_TWINGATE_API_KEY=
#
# Phone: sample | hidden | cytracom
PORTAL_PHONE_PROVIDER=
# scope: a key per company; that company's token is PORTAL_PHONE_CYTRACOM_TOKEN_<KEY>
PORTAL_PHONE_CLIENT_MAP=
# PORTAL_PHONE_CYTRACOM_TOKEN_ACME=   # from ACME's Cytracom admin: Users > Tokens > +New
# PORTAL_PHONE_CALL_HISTORY=on        # reserved; call history not built yet
#
# Shipping: sample | hidden | shipstation | easypost | shippo | manual
PORTAL_SHIPPING_PROVIDER=
PORTAL_SHIPPING_CLIENT_MAP=
# shipstation (scope: a store id)
PORTAL_SHIPPING_SHIPSTATION_API_KEY=
PORTAL_SHIPPING_SHIPSTATION_API_SECRET=
# easypost (scope: "user_<child id>" or "reference:<PREFIX->")
PORTAL_SHIPPING_EASYPOST_API_KEY=
# shippo (scope: "account:<managed account id>" or "metadata:<PREFIX->")
PORTAL_SHIPPING_SHIPPO_API_TOKEN=
# Carrier tracking for staff-entered shipments (manual only). A carrier with
# both its id and secret set gets live status; unset keeps the staff status.
# PORTAL_CARRIER_TRACKING=off stops every lookup. *_ENV=sandbox uses the test host.
PORTAL_CARRIER_UPS_CLIENT_ID=
PORTAL_CARRIER_UPS_CLIENT_SECRET=
# PORTAL_CARRIER_UPS_ENV=production
PORTAL_CARRIER_FEDEX_CLIENT_ID=
PORTAL_CARRIER_FEDEX_CLIENT_SECRET=
# PORTAL_CARRIER_FEDEX_ENV=production
PORTAL_CARRIER_USPS_CLIENT_ID=
PORTAL_CARRIER_USPS_CLIENT_SECRET=
# PORTAL_CARRIER_USPS_ENV=production
# Client vault (DE admin workspace, /portal/admin/clients/:id). Contracts,
# provisioning scripts, agent installers and PII are AES-256-GCM encrypted in
# the app before they are written. Both unset = the vault refuses everything.
# VAULT_ENCRYPTION_KEY: 32+ random chars (openssl rand -base64 48). Back it up
# OUTSIDE this server; without it no stored file can ever be opened.
VAULT_ENCRYPTION_KEY=
# Where ciphertext is kept (dir 0700, files 0600). Include it in backups.
VAULT_STORAGE_DIR=/home/digeratiexperts.com/shared/client-vault
