{
  "_readme": "DE Windows security baseline. Each control: id, title, CIS v8 / CIS Windows benchmark reference where one exists, registry path/name/type/value (or a command check), and 'breaks' notes for known client-application conflicts. Exceptions are recorded per client through the console (approver + expiry), never by editing this file. Registry values are machine policy (HKLM) unless marked user.",
  "version": "1.0.0",
  "profiles": {
    "de-windows-baseline": { "title": "DE Windows baseline (CIS IG1-aligned)", "controls": ["fw-domain", "fw-private", "fw-public", "smartscreen", "smartscreen-edge", "uac-enabled", "uac-admin-prompt", "uac-secure-desktop", "smb1-server", "smb-signing-server", "smb-signing-client", "llmnr-off", "netbios-policy", "rdp-nla", "rdp-disabled", "ps-scriptblock-logging", "ps-module-logging", "ps-transcription-off", "ps2-disabled", "audit-process-creation", "cmdline-in-events", "tls10-client-off", "tls11-client-off", "tls10-server-off", "tls11-server-off", "autorun-off", "autoplay-off", "screen-lock-timeout", "screen-saver-secure", "lsa-protection", "wdigest-off", "guest-disabled", "blank-password-console-only", "lockout-threshold", "min-password-length", "wu-auto", "defender-pua", "lm-hash-off", "anon-sam-off" ] }
  },
  "controls": [
    { "id": "fw-domain", "title": "Windows Firewall on (Domain profile)", "cis": "4.4", "type": "firewall", "profile": "Domain", "value": true },
    { "id": "fw-private", "title": "Windows Firewall on (Private profile)", "cis": "4.4", "type": "firewall", "profile": "Private", "value": true },
    { "id": "fw-public", "title": "Windows Firewall on (Public profile)", "cis": "4.4", "type": "firewall", "profile": "Public", "value": true },
    { "id": "smartscreen", "title": "SmartScreen for apps and files: warn", "cis": "10.1", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "EnableSmartScreen", "valueType": "DWord", "value": 1 },
    { "id": "smartscreen-edge", "title": "Microsoft Edge SmartScreen on", "cis": "9.x", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge", "name": "SmartScreenEnabled", "valueType": "DWord", "value": 1 },
    { "id": "uac-enabled", "title": "UAC enabled", "cis": "5.x", "type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "EnableLUA", "valueType": "DWord", "value": 1, "reboot": true },
    { "id": "uac-admin-prompt", "title": "UAC: prompt for consent on the secure desktop (admins)", "cis": "5.x", "type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "ConsentPromptBehaviorAdmin", "valueType": "DWord", "value": 2 },
    { "id": "uac-secure-desktop", "title": "UAC: switch to the secure desktop", "cis": "5.x", "type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "PromptOnSecureDesktop", "valueType": "DWord", "value": 1 },
    { "id": "smb1-server", "title": "SMBv1 server disabled", "cis": "4.8", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters", "name": "SMB1", "valueType": "DWord", "value": 0, "breaks": "Very old scanners / NAS that only speak SMB1." },
    { "id": "smb-signing-server", "title": "SMB server signing required", "cis": "3.10", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters", "name": "RequireSecuritySignature", "valueType": "DWord", "value": 1, "breaks": "Legacy copiers scanning to a share on this PC." },
    { "id": "smb-signing-client", "title": "SMB client signing required", "cis": "3.10", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters", "name": "RequireSecuritySignature", "valueType": "DWord", "value": 1, "breaks": "Old NAS devices without signing support." },
    { "id": "llmnr-off", "title": "LLMNR disabled", "cis": "4.8", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient", "name": "EnableMulticast", "valueType": "DWord", "value": 0 },
    { "id": "netbios-policy", "title": "NetBIOS node type P-node (no broadcast)", "cis": "4.8", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters", "name": "NodeType", "valueType": "DWord", "value": 2, "breaks": "Workgroup name resolution without DNS." },
    { "id": "rdp-nla", "title": "Remote Desktop requires Network Level Authentication", "cis": "4.x", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp", "name": "UserAuthentication", "valueType": "DWord", "value": 1 },
    { "id": "rdp-disabled", "title": "Inbound Remote Desktop off (remote support uses the DE agent)", "cis": "4.8", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server", "name": "fDenyTSConnections", "valueType": "DWord", "value": 1, "breaks": "Clients who RDP into their desk from a VPN; record an exception." },
    { "id": "ps-scriptblock-logging", "title": "PowerShell script block logging", "cis": "8.8", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging", "name": "EnableScriptBlockLogging", "valueType": "DWord", "value": 1 },
    { "id": "ps-module-logging", "title": "PowerShell module logging", "cis": "8.8", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ModuleLogging", "name": "EnableModuleLogging", "valueType": "DWord", "value": 1 },
    { "id": "ps-transcription-off", "title": "PowerShell transcription not written to world-readable paths", "cis": "8.8", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\Transcription", "name": "EnableTranscripting", "valueType": "DWord", "value": 0, "note": "Transcripts can capture secrets typed at the console; DE relies on script block logging instead." },
    { "id": "ps2-disabled", "title": "Windows PowerShell 2.0 engine removed", "cis": "2.x", "type": "command", "detect": "optionalfeature:MicrosoftWindowsPowerShellV2Root", "value": "Disabled" },
    { "id": "audit-process-creation", "title": "Audit process creation (success)", "cis": "8.2", "type": "auditpol", "subcategory": "{0CCE922B-69AE-11D9-BED3-505054503030}", "value": "Success" },
    { "id": "cmdline-in-events", "title": "Include command line in process creation events", "cis": "8.8", "type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\Audit", "name": "ProcessCreationIncludeCmdLine_Enabled", "valueType": "DWord", "value": 1 },
    { "id": "tls10-client-off", "title": "TLS 1.0 client disabled (SCHANNEL)", "cis": "3.10", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.0\\Client", "name": "Enabled", "valueType": "DWord", "value": 0, "reboot": true, "breaks": "Line-of-business apps that talk to old servers." },
    { "id": "tls11-client-off", "title": "TLS 1.1 client disabled (SCHANNEL)", "cis": "3.10", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.1\\Client", "name": "Enabled", "valueType": "DWord", "value": 0, "reboot": true },
    { "id": "tls10-server-off", "title": "TLS 1.0 server disabled (SCHANNEL)", "cis": "3.10", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.0\\Server", "name": "Enabled", "valueType": "DWord", "value": 0, "reboot": true },
    { "id": "tls11-server-off", "title": "TLS 1.1 server disabled (SCHANNEL)", "cis": "3.10", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.1\\Server", "name": "Enabled", "valueType": "DWord", "value": 0, "reboot": true },
    { "id": "autorun-off", "title": "AutoRun disabled for all drives", "cis": "10.3", "type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "NoDriveTypeAutoRun", "valueType": "DWord", "value": 255 },
    { "id": "autoplay-off", "title": "AutoPlay off for non-volume devices", "cis": "10.3", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer", "name": "NoAutoplayfornonVolume", "valueType": "DWord", "value": 1 },
    { "id": "screen-lock-timeout", "title": "Machine inactivity lock at 15 minutes", "cis": "4.3", "type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "InactivityTimeoutSecs", "valueType": "DWord", "value": 900 },
    { "id": "screen-saver-secure", "title": "Password-protected screen saver (user policy)", "cis": "4.3", "type": "registry", "path": "HKCU:\\Software\\Policies\\Microsoft\\Windows\\Control Panel\\Desktop", "name": "ScreenSaverIsSecure", "valueType": "String", "value": "1", "scope": "user" },
    { "id": "lsa-protection", "title": "LSA protection (RunAsPPL)", "cis": "4.x", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RunAsPPL", "valueType": "DWord", "value": 1, "reboot": true, "breaks": "Unsigned LSA plug-ins (some legacy smart-card or SSO add-ons)." },
    { "id": "wdigest-off", "title": "WDigest does not store cleartext credentials", "cis": "4.x", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\WDigest", "name": "UseLogonCredential", "valueType": "DWord", "value": 0 },
    { "id": "guest-disabled", "title": "Guest account disabled", "cis": "5.3", "type": "localuser", "name": "Guest", "value": "Disabled" },
    { "id": "blank-password-console-only", "title": "Blank passwords limited to console logon", "cis": "5.x", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "LimitBlankPasswordUse", "valueType": "DWord", "value": 1 },
    { "id": "lockout-threshold", "title": "Account lockout after 10 bad attempts", "cis": "6.x", "type": "netaccounts", "setting": "lockoutthreshold", "value": 10 },
    { "id": "min-password-length", "title": "Local minimum password length 14", "cis": "5.2", "type": "netaccounts", "setting": "minpwlen", "value": 14 },
    { "id": "wu-auto", "title": "Windows Update: automatic download and scheduled install", "cis": "7.3", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "AUOptions", "valueType": "DWord", "value": 4, "note": "Applied only when the client profile sets updates.authority to windows; JumpCloud (default) and Intune enforce their own update policy, checked by maint.update-authority." },
    { "id": "defender-pua", "title": "Defender potentially unwanted app blocking (when Defender is active)", "cis": "10.1", "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender", "name": "PUAProtection", "valueType": "DWord", "value": 1 },
    { "id": "lm-hash-off", "title": "Do not store LAN Manager hash", "cis": "3.10", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "NoLMHash", "valueType": "DWord", "value": 1 },
    { "id": "anon-sam-off", "title": "No anonymous enumeration of SAM accounts and shares", "cis": "4.x", "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RestrictAnonymous", "valueType": "DWord", "value": 1 }
  ]
}
