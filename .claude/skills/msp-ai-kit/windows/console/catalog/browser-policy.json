{
  "_readme": "Browser policy for Chrome, Edge and Brave (HKLM Chromium policy) and Firefox (HKLM Mozilla policy). Profiles hold the settings; 'control' holds the extension catalog: DE services that are always forced in, the approved password managers (one is chosen per client with browser.loginManager), and blocked groups that conflict with DE services. Store ids marked confirmed:false must be checked against the store page before relying on them; the console reports them. The Browser Configurator backs up the previous policy for rollback and verifies by re-reading the registry.",
  "version": "1.1.0",
  "profiles": {
    "de-browser-policy": {
      "title": "DE standard browser policy",
      "common": {
        "PasswordManagerEnabled": 0,
        "SafeBrowsingProtectionLevel": 1,
        "BrowserSignin": 1,
        "SyncDisabled": 0,
        "DownloadRestrictions": 1,
        "BlockThirdPartyCookies": 0,
        "RestoreOnStartup": 4,
        "ShowHomeButton": 1,
        "DefaultBrowserSettingEnabled": 0,
        "AutofillCreditCardEnabled": 0,
        "BackgroundModeEnabled": 0,
        "PromptForDownloadLocation": 0,
        "AutofillAddressEnabled": 0
      },
      "chrome": {
        "IncognitoModeAvailability": 1,
        "ChromeCleanupEnabled": 1
      },
      "edge": {
        "InPrivateModeAvailability": 1,
        "SmartScreenEnabled": 1,
        "SmartScreenPuaEnabled": 1,
        "HideFirstRunExperience": 1,
        "EdgeShoppingAssistantEnabled": 0,
        "PersonalizationReportingEnabled": 0,
        "PasswordGeneratorEnabled": 0
      },
      "extensions": {
        "mode": "approved-only",
        "approved": [],
        "blocked": [],
        "note": "approved-only blocks every extension except the DE services, the client's password manager and the client's approved list. 'blocklist' mode blocks only the catalog's blocked groups and the client's blocked list."
      },
      "urlBlocklist": [],
      "urlAllowlist": [],
      "updates": {
        "chromeUpdatePolicy": 1,
        "edgeUpdatePolicy": 1
      }
    },
    "de-browser-policy-relaxed": {
      "title": "DE relaxed (co-managed / developer seats)",
      "common": {
        "PasswordManagerEnabled": 0,
        "SafeBrowsingProtectionLevel": 1,
        "DownloadRestrictions": 0,
        "RestoreOnStartup": 1
      },
      "chrome": {
        "IncognitoModeAvailability": 0
      },
      "edge": {
        "InPrivateModeAvailability": 0,
        "SmartScreenEnabled": 1
      },
      "extensions": {
        "mode": "blocklist",
        "approved": [],
        "blocked": []
      },
      "urlBlocklist": [],
      "urlAllowlist": [],
      "updates": {
        "chromeUpdatePolicy": 1,
        "edgeUpdatePolicy": 1
      }
    }
  },
