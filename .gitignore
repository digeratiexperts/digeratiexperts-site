node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
.env
.env.*
# the template is safe to track (no values)
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# Licensed 3D / design source packs — never public, never force-commit binaries
# Keep README.md and .gitkeep tracked under assets/licensed/
assets/licensed/**/*.zip
assets/licensed/**/*.rar
assets/licensed/**/*.7z
assets/licensed/**/*.blend
assets/licensed/**/*.obj
assets/licensed/**/*.fbx
assets/licensed/**/*.max
assets/licensed/**/*.c4d
assets/licensed/**/*.psd
assets/licensed/**/*.ai
assets/licensed/**/*.gltf
assets/licensed/**/*.glb
assets/licensed/**/*.mtl
assets/licensed/**/*.tiff
assets/licensed/**/*.tif
assets/licensed/**/*.exr
assets/licensed/**/*.hdr
assets/licensed/**/*.png
assets/licensed/**/*.jpg
assets/licensed/**/*.jpeg
assets/licensed/**/*.webp
assets/licensed/**/*.avif
assets/licensed/**/*.svg
assets/licensed/**/*.mp4
assets/licensed/**/*.mov
assets/licensed/**/*.pdf
# Allow small text/license docs + scaffold READMEs; ignore everything else binary-heavy
!assets/licensed/README.md
!assets/licensed/**/README.md
!assets/licensed/**/.gitkeep
!assets/licensed/**/LICENSE*
!assets/licensed/**/license*
!assets/licensed/**/*.txt

# Private photography originals (publish only optimized derivatives under client/public)
assets/photography/**/ORIGINAL/**
!assets/photography/**/ORIGINAL/.gitkeep
!assets/photography/**/README.md
assets/photography/**/*.{jpg,jpeg,png,webp,avif,heic,tif,tiff,raw,cr2,nef}

# Live threat-intel cache (regenerated by the in-process scheduler)
data/threat-feed.json

# Vendored pdf.js assets (regenerated by scripts/vendor-pdfjs.mjs on predev/prebuild)
client/public/vendor/
.playwright-mcp/

# Scrollcraft build artifacts: BRIEF.md and FINGERPRINTS.md are tracked;
# harness screenshots and local probe scripts are regenerated per run
# (curated evidence goes to artifacts/visual-qa/ instead)
scrollcraft/builds/*/lab/
scrollcraft/builds/*/out/
/lab/

# Claude Code session worktrees (local working copies, never repository content)
.claude/worktrees/

# diagram-system review gallery build output
scrollcraft/diagrams/lab/
# web-design-rules screenshot helper output (regenerated per run)
temporary screenshots/

# Raw visual-review capture PNGs are regenerable at any time with
# scripts/capture-page-review.mjs; only the compressed web/ set and the review
# board are tracked, so a capture run does not add ~20 MB per route.
artifacts/visual-qa/*-review/*.png
artifacts/visual-qa/*-directions/shots/*.png
