+}
+.d2-msearch input::placeholder {
+  color: rgba(5, 3, 18, 0.55);
+}
+.d2-msearch button {
+  flex: none;
+  width: 3.4rem;
+  display: grid;
+  place-items: center;
+  border: 0;
+  background: var(--de-magenta);
+  color: #fff;
+  cursor: pointer;
+  transition: background-color 150ms var(--d2-ease);
+}
+.d2-msearch button:hover {
+  background: var(--de-magenta-hover);
