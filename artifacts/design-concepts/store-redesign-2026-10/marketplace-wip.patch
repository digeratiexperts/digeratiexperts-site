+ * situation groups as white boxes over the banner's edge, then a light field
+ * with goal filters, the family list and the rail. Concept 2 of
+ * artifacts/design-concepts/store-redesign-2026-10. The elevation ladder is
+ * field → white box → floating rail; nothing dark sits on dark any more.
+ */
+
+/* A light scope any Store surface can wear: the profile panel's inks (every one clears 4.5:1 on the field and on white). */
+.d2-light {
+  --d2-rule: rgba(5, 3, 18, 0.14);
+  --d2-ink-strong: var(--de-bg);
+  --d2-ink: rgba(5, 3, 18, 0.78);
+  --d2-ink-soft: rgba(5, 3, 18, 0.64);
+  --d2-accent: rgb(var(--de-accent-rgb));
+  --d2-accent-ink: color-mix(in srgb, rgb(var(--de-accent-rgb)) 75%, var(--de-bg));
+  --d2-error-ink-panel: color-mix(in srgb, hsl(var(--destructive)) 80%, var(--de-bg));
+  color: var(--d2-ink-strong);
+}
+.d2-light .d2-action--quiet,
+.d2-light .d2-link {
+  text-decoration-color: rgba(5, 3, 18, 0.3);
+}
+.d2-light .d2-toggle:hover {
+  border-color: rgba(5, 3, 18, 0.35);
+}
+.d2-light :is(a, button, input, select, textarea, [tabindex]):focus-visible,
+.d2-light .d2-tile:has(input:focus-visible) {
+  outline-color: var(--de-magenta);
+}
+
+.d2-market {
+  --d2-mfield: #eceef2;
+  --d2-mcard: var(--de-paper-raised);
+  --d2-mshadow-1: 0 1px 2px rgba(5, 3, 18, 0.07);
+  --d2-mshadow-2: 0 1px 3px rgba(5, 3, 18, 0.06), 0 12px 30px -16px rgba(5, 3, 18, 0.3);
+  position: relative;
+  z-index: 1;
+}
+.d2-mwrap {
+  width: 100%;
+  max-width: 1360px;
+  margin: 0 auto;
+  padding-left: 1rem;
+  padding-right: 1rem;
+}
+@media (min-width: 640px) {
+  .d2-mwrap {
+    padding-left: 1.5rem;
+    padding-right: 1.5rem;
+  }
+}
+
+/* Store bar */
+.d2-mbar {
+  background: var(--de-bg);
+  border-bottom: 1px solid var(--de-hairline);
+}
+.d2-mbar__row {
+  display: flex;
+  flex-wrap: wrap;
