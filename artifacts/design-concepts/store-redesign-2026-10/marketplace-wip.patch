+}
+.d2-msearch:focus-within {
+  box-shadow: 0 0 0 3px rgb(var(--de-accent-rgb) / 0.6);
+}
+.d2-msearch input {
+  flex: 1 1 auto;
+  min-width: 0;
+  border: 0;
+  outline: 0;
+  padding: 0 1rem;
+  background: transparent;
+  color: var(--de-bg);
