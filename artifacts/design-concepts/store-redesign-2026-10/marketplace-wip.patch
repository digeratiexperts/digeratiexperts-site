+}
+.d2-mrow__title {
+  font-family: "Space Grotesk", sans-serif;
+  font-size: 15px;
+  font-weight: 700;
+  line-height: 1.3;
+  color: var(--d2-ink-strong);
+}
+.d2-mrow__marks {
+  margin-top: 0.2rem;
+  font-size: 13px;
+  line-height: 1.45;
+  color: var(--d2-ink-soft);
+}
+.d2-mrow__action {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  min-height: 2.75rem;
+  padding: 0 0.85rem;
+  border: 1px solid rgba(5, 3, 18, 0.22);
+  border-radius: 0.6rem;
+  background: var(--d2-mcard);
+  color: var(--d2-ink-strong);
+  font-size: 14px;
+  font-weight: 600;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: border-color 150ms var(--d2-ease), background-color 150ms var(--d2-ease);
+}
+.d2-mrow__action:hover {
+  border-color: var(--d2-ink-strong);
+}
+.d2-mrow__action--done {
+  border-color: var(--d2-accent);
+  color: var(--d2-accent-ink);
+}
+.d2-mrow[data-state="added"] .d2-mrow__title {
+  color: var(--d2-accent-ink);
+}
+
+/* Catalog: filters | list | rail */
+.d2-mcatalog {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1.25rem;
+  align-items: start;
+  margin-top: 1.75rem;
+}
+.d2-mfilters {
+  border-radius: 0.9rem;
+  background: var(--d2-mcard);
+  padding: 0.9rem 1rem 0.4rem;
+  box-shadow: var(--d2-mshadow-1);
+}
+.d2-mfilters fieldset {
+  border: 0;
+  margin: 0;
+  padding: 0;
+  min-width: 0;
+}
+.d2-mfilters legend {
+  margin-bottom: 0.25rem;
+  font-family: "Oxanium", sans-serif;
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--d2-ink-soft);
+}
+.d2-mfilters label {
+  display: flex;
+  align-items: center;
+  gap: 0.65rem;
+  min-height: 2.75rem;
+  font-size: 14px;
+  color: var(--d2-ink);
+  cursor: pointer;
+}
+.d2-mfilters input {
+  flex: none;
+  width: 1.15rem;
+  height: 1.15rem;
+  accent-color: rgb(var(--de-accent-rgb));
+}
+.d2-mfilters__count {
+  margin-left: auto;
+  font-family: "Oxanium", sans-serif;
+  font-size: 12px;
+  color: var(--d2-ink-soft);
+}
+.d2-mfilters .d2-action--quiet:disabled {
+  opacity: 0.45;
+}
+@media (max-width: 1023px) {
+  /* Below the rail breakpoint the filters are one scrolling row of chips. */
+  .d2-mfilters {
+    padding: 0.6rem 0.75rem;
+  }
+  .d2-mfilters fieldset {
+    display: flex;
+    gap: 0.5rem;
+    overflow-x: auto;
+    scrollbar-width: none;
+  }
+  .d2-mfilters legend {
+    float: left;
+    margin: 0;
+    align-self: center;
+  }
+  .d2-mfilters label {
+    flex: none;
+    min-height: 2.5rem;
+    padding: 0 0.8rem;
+    border: 1px solid var(--d2-rule);
+    border-radius: 9999px;
+    white-space: nowrap;
+  }
+  .d2-mfilters label:has(input:checked) {
+    border-color: var(--d2-accent);
+    color: var(--d2-accent-ink);
+  }
+  .d2-mfilters .d2-mfilters__count {
+    margin-left: 0;
+  }
+}
+@media (min-width: 1024px) {
+  .d2-mcatalog {
+    grid-template-columns: 220px minmax(0, 1fr) 300px;
+  }
+  .d2-mfilters {
+    position: sticky;
+    top: calc(var(--de-nav-current-bottom, 6rem) + 1rem);
+  }
+}
+.d2-mresults__title {
+  font-family: "Space Grotesk", sans-serif;
+  font-size: clamp(1.4rem, 2.4vw, 1.75rem);
+  font-weight: 700;
+  line-height: 1.15;
+}
+.d2-mlist {
+  list-style: none;
+  margin: 0.5rem 0 0;
+  padding: 0;
+  display: grid;
+  gap: 0.75rem;
+}
+
+/* A family as a list item */
+.d2-mitem {
+  display: grid;
+  grid-template-columns: 4rem minmax(0, 1fr);
+  gap: 0.9rem 1rem;
+  align-items: start;
+  border: 1px solid transparent;
+  border-radius: 0.9rem;
+  background: var(--d2-mcard);
+  padding: 0.9rem;
+  box-shadow: var(--d2-mshadow-1);
+  transition: border-color 150ms var(--d2-ease), box-shadow 200ms var(--d2-ease);
+}
+.d2-mitem:hover {
+  border-color: var(--d2-rule);
+  box-shadow: var(--d2-mshadow-2);
+}
+.d2-mitem[data-state="added"] {
+  border-color: var(--d2-accent);
+}
+.d2-mitem__thumb {
+  width: 4rem;
+  height: 4rem;
+  border-radius: 0.65rem;
+  display: grid;
+  place-items: center;
+  background: radial-gradient(120% 120% at 20% 0%, color-mix(in srgb, rgb(var(--de-accent-rgb)) 6%, white), color-mix(in srgb, rgb(var(--de-accent-rgb)) 12%, var(--d2-mfield)));
+  color: var(--d2-accent-ink);
+}
+.d2-mitem__thumb svg {
+  width: 1.8rem;
+  height: 1.8rem;
+}
+.d2-mitem__goal {
+  font-family: "Oxanium", sans-serif;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--d2-ink-soft);
+}
+.d2-mitem__title {
+  margin-top: 0.1rem;
+  font-family: "Space Grotesk", sans-serif;
+  font-size: 1.05rem;
+  font-weight: 700;
+  line-height: 1.3;
+}
+.d2-mitem__title a {
+  color: var(--d2-ink-strong);
+  text-decoration: none;
+}
+.d2-mitem__title a:hover {
+  text-decoration: underline;
+  text-underline-offset: 4px;
+}
+.d2-mitem__detail {
+  margin-top: 0.25rem;
+  font-size: 14px;
+  line-height: 1.5;
+  color: var(--d2-ink);
+}
+.d2-mitem__meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1rem;
+  margin: 0.5rem 0 0;
+  padding: 0;
+  list-style: none;
+  font-size: 13px;
+  color: var(--d2-ink);
+}
+.d2-mitem__meta li {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+}
+.d2-mitem__meta svg {
+  flex: none;
+  color: #137a49;
+}
+.d2-mitem__acts {
+  grid-column: 1 / -1;
+  display: flex;
+  gap: 0.5rem;
+}
+.d2-mitem__acts > * {
+  flex: 1 1 0;
+}
+.d2-mitem__add,
+.d2-mitem__view {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 2.75rem;
+  padding: 0 1rem;
+  border-radius: 0.6rem;
+  font-size: 14px;
+  font-weight: 600;
+  white-space: nowrap;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 150ms var(--d2-ease), border-color 150ms var(--d2-ease), color 150ms var(--d2-ease);
+}
+.d2-mitem__add {
+  border: 1px solid transparent;
+  background: rgb(var(--de-accent-rgb));
+  color: #fff;
+}
+.d2-mitem__add:hover {
+  background: color-mix(in srgb, rgb(var(--de-accent-rgb)) 85%, var(--de-bg));
+}
+.d2-mitem__add[aria-pressed="true"] {
+  background: var(--d2-mcard);
+  border-color: var(--d2-accent);
+  color: var(--d2-accent-ink);
+}
+.d2-mitem__view {
+  border: 1px solid rgba(5, 3, 18, 0.22);
+  background: var(--d2-mcard);
+  color: var(--d2-ink-strong);
+}
+.d2-mitem__view:hover {
+  border-color: var(--d2-ink-strong);
+}
+.d2-mitem__undo {
+  grid-column: 1 / -1;
+}
+@media (min-width: 640px) {
+  .d2-mitem {
+    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
+    align-items: center;
+    padding: 1rem;
+  }
+  .d2-mitem__thumb {
+    width: 6.5rem;
+    height: 5.5rem;
+  }
+  .d2-mitem__thumb svg {
+    width: 2.25rem;
+    height: 2.25rem;
+  }
+  .d2-mitem__acts {
+    grid-column: auto;
+    flex-direction: column;
+    min-width: 9.5rem;
+  }
+}
+
+/* The rail on the light field: a white floating card, the top of the ladder. */
+.d2-market .d2-rail {
+  border-color: transparent;
+  background: var(--d2-mcard);
+  box-shadow: var(--d2-mshadow-2);
+}
+.d2-market .d2-status__mark {
+  border-color: rgba(5, 3, 18, 0.3);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .d2-mitem,
+  .d2-mrow__action,
+  .d2-msearch,
+  .d2-mgoals a {
+    transition: none;
+  }
+}
