# Copy to .env (gitignored). Never commit real values.
#
# kie.ai image/video generation. KIE_AI_API_KEY is the name to set. Every kie.ai tool
# here (nano-banana-images, excalidraw-visuals, scrollcraft, kie-budget) reads it first
# and also accepts KIE_API_KEY as an alias, so an older .env that only has
# KIE_API_KEY keeps working. You do not need both.
# Get the key from https://kie.ai -> account settings. Each generation spends credits.
KIE_AI_API_KEY=
#
# For Claude Code on the web, add the same variable(s) to the environment's settings
# (Environment -> Environment variables) instead of a .env file, and allow api.kie.ai and
# kieai.redpandaai.co in that environment's network policy if generation should run there.
#
# Portal QA login for Digerati Experts test runs. Set the same names in the
# host environment for the portal process. This does not create an account.
# Use a DE test company, never a client tenant. Never commit the values.
PORTAL_QA_EMAIL=
PORTAL_QA_PASSWORD=

# RECRAFT_API_KEY -> .claude/skills/recraft-icons (paid Recraft plan; free-plan images are not licensed for commercial use)
RECRAFT_API_KEY=

# GEOAPIFY_API_KEY -> server/addressLookup.ts: address type-ahead on checkout and portal forms
# (Geoapify free tier, 3,000 lookups/day; Joe 2026-10-15). Unset = plain address inputs, no lookup.
GEOAPIFY_API_KEY=

# DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD -> DataForSEO MCP server (.mcp.json, .cursor/mcp.json) and keyword research.
# The API login and API password from app.dataforseo.com/api-access, not the website login. Prepaid account:
# keep the balance small, no auto top-up, no IP whitelist (docs/CONTENT-TOOLING-PLAN.md, Step 3).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Portal MFA. MFA_ENCRYPTION_KEY encrypts authenticator-app secrets and must be set
# in production. WEBAUTHN_RP_ID is the passkey relying-party domain; it defaults to
# digeratiexperts.com on any *.digeratiexperts.com host, else the request host.
MFA_ENCRYPTION_KEY=
WEBAUTHN_RP_ID=

# Client vault (DE admin workspace): encrypts contracts, provisioning scripts,
# agent installers and PII per client before they reach object storage. 32+
# random characters (e.g. `openssl rand -base64 48`). Keep it stable and backed
# up outside the server: files stored under one key cannot be opened without
# it. Unset = the vault refuses all uploads and downloads (fails closed).
VAULT_ENCRYPTION_KEY=
# Where the ciphertext lives: a directory (VPS), else PRIVATE_OBJECT_DIR object storage.
VAULT_STORAGE_DIR=
