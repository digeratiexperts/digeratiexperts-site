// Builds the design-system manifest: tokens (read from client/src/index.css),
// components (registry + a real import scan), homepage versions, changelog.
//
//   npm run design-system:build   write design/design-system.json and the
//                                 copy the styleguide imports
//   npm run design-system:check   fail if either file is stale, a registered
//                                 component file is missing, or a deprecated
//                                 component is still imported
//
// Read-only on source. Free, no network. The manifest is for people and for
// coding agents: use these tokens and components instead of inventing new ones.

import { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { CHANGELOG, COMPONENTS, TOKEN_GROUPS } from "../../client/src/design-system/registry";
import { HOMEPAGE_VERSIONS } from "../../client/src/pages/versions/registry";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
const CSS = join(ROOT, "client/src/index.css");
const OUT_MANIFEST = join(ROOT, "design/design-system.json");
const OUT_CLIENT = join(ROOT, "client/src/design-system/manifest.generated.json");

function readTokens() {
  const css = readFileSync(CSS, "utf8");
  return TOKEN_GROUPS.map((group) => ({
    id: group.id,
    label: group.label,
    tokens: group.names.map((name) => {
      const match = css.match(new RegExp(`(^|[\\s;{])${name.replace(/[-]/g, "\\-")}\\s*:\\s*([^;]+);`, "m"));
      return { name, value: match ? match[2].trim() : null };
    }),
  }));
}

function walk(dir: string, out: string[] = []): string[] {
  for (const entry of readdirSync(dir)) {
    const full = join(dir, entry);
    if (statSync(full).isDirectory()) walk(full, out);
    else if (/\.(ts|tsx)$/.test(entry) && !/\.test\.(ts|tsx)$/.test(entry)) out.push(full);
  }
  return out;
}

function specifiers(source: string): string[] {
  const found: string[] = [];
  const re = /(?:from\s+|import\s*\(\s*|import\s+)["']([^"']+)["']/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(source))) found.push(m[1]);
  return found;
}

function resolveSpecifier(spec: string, fromFile: string): string | null {
  let base: string;
  if (spec.startsWith("@/")) base = join(ROOT, "client/src", spec.slice(2));
  else if (spec.startsWith(".")) base = resolve(dirname(fromFile), spec);
  else return null;
  return base;
}

function build() {
  const files = walk(join(ROOT, "client/src"));
  const imports = files.map((file) => ({
    file,
    targets: specifiers(readFileSync(file, "utf8"))
      .map((s) => resolveSpecifier(s, file))
      .filter((t): t is string => t !== null),
  }));

  const components = COMPONENTS.map((c) => {
    const abs = join(ROOT, c.file);
    const stem = abs.replace(/\.(tsx|ts)$/, "");
    const users = imports
      .filter((i) => i.file !== abs && i.targets.some((t) => t === stem || t === `${stem}/index`))
      .map((i) => relative(ROOT, i.file).split("\\").join("/"));
    return {
      id: c.id,
      name: c.name,
      file: c.file,
      exists: existsSync(abs),
      status: c.status,
      tier: c.tier,
      purpose: c.purpose,
      dos: c.dos,
      donts: c.donts,
      accessibility: c.accessibility,
      adoption: { files: users.length, sample: users.sort().slice(0, 5) },
    };
  });

  return {
    schema: 1,
    note:
      "Generated by scripts/design-system/build.mts. Do not edit by hand. Tokens are read from client/src/index.css; components come from client/src/design-system/registry.ts. Authority tiers: design/DESIGN-AUTHORITY.md.",
    tokenGroups: readTokens(),
    components,
    versions: HOMEPAGE_VERSIONS.map((v) => ({
      n: v.n,
      path: v.path,
      title: v.title,
      date: v.date,
      kind: v.kind,
      status: v.status,
    })),
    changelog: CHANGELOG,
  };
}

const manifest = build();
const text = `${JSON.stringify(manifest, null, 2)}\n`;

if (process.argv.includes("--check")) {
  const problems: string[] = [];
  for (const c of manifest.components) {
    if (!c.exists) problems.push(`registered component file missing: ${c.file}`);
    if (c.status === "deprecated" && c.adoption.files > 0)
      problems.push(`deprecated component still imported by ${c.adoption.files} file(s): ${c.name}`);
  }
  for (const g of manifest.tokenGroups)
    for (const t of g.tokens) if (t.value === null) problems.push(`token not found in index.css: ${t.name}`);
  for (const out of [OUT_MANIFEST, OUT_CLIENT]) {
    if (!existsSync(out) || readFileSync(out, "utf8") !== text) problems.push(`stale: ${relative(ROOT, out)} (run npm run design-system:build)`);
  }
  if (problems.length) {
    console.error(problems.map((p) => `design-system: ${p}`).join("\n"));
    process.exit(1);
  }
  console.log(`design-system: ok (${manifest.components.length} components, ${manifest.tokenGroups.reduce((n, g) => n + g.tokens.length, 0)} tokens)`);
} else {
  writeFileSync(OUT_MANIFEST, text);
  writeFileSync(OUT_CLIENT, text);
  console.log(`design-system: wrote ${relative(ROOT, OUT_MANIFEST)} and ${relative(ROOT, OUT_CLIENT)}`);
}
