        "default": 168,
        "max": 720
      },
      "valueField": "secretValue",
      "valueReturned": "never",
      "reveal": "hub_staff_only",
      "errors": {
        "400": "body does not match the contract (details never echo the value)",
        "401": "unsigned, bad signature, or legacy secret",
        "404": "ticket missing, not this account's, or (no account) not an unlinked website-widget ticket",
