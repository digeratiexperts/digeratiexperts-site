        "optional": [
          "portalClientId"
        ]
      },
      "auth": {
        "source": "portal",
        "scopedSecretEnv": "PORTAL_TO_HUB_SECRET",
        "signsQuery": true,
        "legacySecret": "refused"
      },
      "responseFields": [
        "contract",
        "accountId",
        "generatedAt",
        "items",
        "totals"
      ],
      "itemFields": [
        "productId",
        "kind",
        "vendor",
        "product",
        "category",
        "catalogKey",
        "sku",
        "chocoPackage",
        "seats"
      ],
      "seatFields": [
        "total",
        "fromPool",
        "toOrder"
      ],
      "totalsFields": [
        "products",
        "seats",
        "fromPool",
        "toOrder"
      ],
      "kinds": [
        "license",
        "app"
      ],
      "seatSources": [
        "pool",
        "order"
      ],
      "errors": {
        "401": "unsigned, bad signature, or legacy secret",
        "409": "accountId missing, unknown, or not the portalClientId's account",
        "503": "integration not configured or tables not pushed"
      },
      "signingSample": {
        "method": "GET",
        "path": "/api/webhooks/portal/licenses?accountId=41",
        "timestamp": "2026-11-05T16:00:00.000Z",
