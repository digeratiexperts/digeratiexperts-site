{
  "version": 1,
  "sources": ["website", "portal", "techsales", "techconsole"],
  "eventTypes": [
    "lead.created",
    "quote.requested",
    "assessment.submitted",
    "store.order_created",
    "referral.submitted",
    "consultation.booked",
    "account.profile_update_requested",
    "quote.response_submitted",
    "approval.submitted",
    "assessment.response_submitted",
    "onboarding.response_submitted",
    "document.acknowledged",
    "service.change_requested",
    "account.updated",
    "client.created",
    "client.updated",
    "deal.created",
    "deal.stage_changed",
    "quote.created",
    "quote.updated",
    "quote.sent",
    "quote.accepted",
    "quote.rejected",
    "quote.expired",
    "agreement.created",
    "agreement.updated",
    "signature.requested",
    "signature.completed",
    "order.created",
    "order.updated",
    "handoff.created",
    "handoff.updated",
    "onboarding.updated",
    "assessment.updated",
    "roadmap.updated",
    "service_entitlement.created",
    "service_entitlement.updated",
    "service_entitlement.ended",
    "catalog.published",
    "pricing.updated",
    "bundle.updated",
    "device.observed",
    "device.rescue_handoff",
    "device.warranty",
    "device.deployment",
    "email_migration.recorded",
    "service_request.upserted"
  ],
  "envelopeFields": [
    "eventId",
    "eventType",
    "version",
    "source",
    "occurredAt",
    "correlationId",
    "entityType",
    "entityId",
    "canonicalAccountId",
    "originEventId",
    "payload"
  ],
  "identity": {
    "canonicalAccountId": "envelope",
    "portalClientId": "payload"
  },
  "signing": {
    "algorithm": "HMAC-SHA256",
    "canonicalLines": ["METHOD", "PATH", "TIMESTAMP", "EVENT_ID", "SHA256_BODY"],
    "timestampSkewMs": 300000,
    "sample": {
      "method": "POST",
      "path": "/api/integrations/v1/website/leads",
      "timestamp": "2026-09-26T16:00:00.000Z",
      "eventId": "11111111-1111-4111-8111-111111111111",
      "body": "{}",
      "secret": "test-secret",
      "signature": "191e6664e6f48e245ab93977c0f1e1fb5fae829b9a447717d18e9ea9e982f492"
    }
  },
  "reads": {
    "portalLicenses": {
      "contract": "de.hub.licenses/v1",
      "direction": "portal_to_hub",
      "method": "GET",
      "path": "/api/webhooks/portal/licenses",
      "query": {
        "required": [
          "accountId"
        ],
        "optional": [
          "portalClientId"
        ]
      },
      "auth": {
        "source": "portal",
        "scopedSecretEnv": "PORTAL_TO_HUB_SECRET",
        "signsQuery": true,
        "legacySecret": "refused"
      },
      "responseFields": [
        "contract",
        "accountId",
        "generatedAt",
        "items",
        "totals"
      ],
      "itemFields": [
        "productId",
        "kind",
        "vendor",
        "product",
        "category",
        "catalogKey",
        "sku",
        "chocoPackage",
        "seats"
      ],
      "seatFields": [
        "total",
        "fromPool",
        "toOrder"
      ],
      "totalsFields": [
        "products",
        "seats",
        "fromPool",
        "toOrder"
      ],
      "kinds": [
        "license",
        "app"
      ],
      "seatSources": [
        "pool",
        "order"
      ],
      "errors": {
        "401": "unsigned, bad signature, or legacy secret",
        "409": "accountId missing, unknown, or not the portalClientId's account",
        "503": "integration not configured or tables not pushed"
      },
      "signingSample": {
        "method": "GET",
        "path": "/api/webhooks/portal/licenses?accountId=41",
        "timestamp": "2026-11-05T16:00:00.000Z",
        "eventId": "66666666-6666-4666-8666-666666666666",
        "body": "{}",
        "secret": "test-secret",
        "signature": "b2aeb8e22aad503bec5b3a1aeb281f8498af9af855946f2e1e609b5a31968b00"
      }
    }
  }
}
